# Supabase (app works with mock data even if unset)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public token (pk.). Falls back to a built-in token if unset.
# Restrict this token by URL in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Meta Pixel ID for the ad landing pages (/quiz). Leave empty and no pixel
# script is loaded at all. GA4 is hardwired in scripts/inject-head.mjs.
# Vercel の環境変数にも同じ値を入れること（入れないと本番で計測されない）。
EXPO_PUBLIC_META_PIXEL_ID=
